{
  "name": "{{ name }}",
  "version": "0.0.0",
  "description": "{{ description }}",
  "private": true,
  "scripts": {
    "dev": "vue-cli-service serve",
    {{#e2e}}
    "dev:e2e": "vue-cli-service test:e2e --mode=development",
    {{/e2e}}
    "build": "vue-cli-service build",
    "build:ci": "vue-cli-service build --report",
    {{#lint}}
    "lint": "eslint --ext .js,.vue,.ts --fix . && stylelint --fix \"src/**/*.vue\" \"src/**/*.scss\" && markdownlint docs/*.md *.md && prettier --list-different --write \"**/*.{js,ts,json,css,scss,vue,md}\"",
    {{/lint}}
    {{#unit}}
    "unit": "vue-cli-service test:unit",
    "unit:watch": "npm run unit --watch --notify --notifyMode change",
    {{/unit}}
    {{#e2e}}
    "e2e": "vue-cli-service test:e2e --headless",
    {{/e2e}}
    {{#if_and unit e2e}}
    "test": "npm run unit && npm run e2e",
    {{/if_and}}
    {{#lint}}
    "test:ci": "npm run lint && vue-cli-service test:unit --coverage --ci && npm run e2e",
    {{/lint}}
    "new": "hygen new",
    "docs": "vuepress dev"
  },
  {{#lint}}
  "gitHooks": {
    "pre-commit": "cross-env PRE_COMMIT=true lint-staged"
  },
  {{/lint}}
  "engines": {
    "node": ">=16.0.0",
    "yarn": ">=1.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@vue/cli-shared-utils": "^5.0.8",
    "axios": "^1.6.0",
    {{#mobile}}
    "fastclick": "^1.0.6",
    {{/mobile}}
    "normalize.css": "^8.0.1",
    {{#mobile}}
    "postcss-aspect-ratio-mini": "^1.1.0",
    "postcss-px-to-viewport": "^1.1.1",
    "postcss-viewport-units": "^0.1.6",
    "postcss-write-svg": "^3.0.1",
    {{/mobile}}
    "vue": "^3.3.8",
    {{#router}}
    "vue-router": "^4.2.5",
    {{/router}}
    {{#vuex}}
    "pinia": "^2.1.7",
    {{/vuex}}
    {{#warm}}
    "element-plus": "^2.4.4",
    {{/warm}}
    {{#wbui}}
    "vant": "^4.8.0",
    {{/wbui}}
    {{#typescript}}
    "vue-tsc": "^1.8.22",
    {{/typescript}}
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@vue/cli-plugin-babel": "^5.0.8",
    {{#e2e}}
    "@vue/cli-plugin-e2e-cypress": "^5.0.8",
    {{/e2e}}
    {{#lint}}
    "@vue/cli-plugin-eslint": "^5.0.8",
    {{/lint}}
    {{#unit}}
    "@vue/cli-plugin-unit-jest": "^5.0.8",
    {{/unit}}
    "@vue/cli-service": "^5.0.8",
    {{#lint}}
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-standard": "^8.0.1",
    {{/lint}}
    {{#unless lint}}
    "prettier": "^3.0.0",
    {{/unless}}
    "@vue/test-utils": "^2.4.0",
    "babel-core": "^7.0.0-bridge.0",
    {{#unit}}
    "babel-jest": "^29.0.0",
    {{/unit}}
    "babel-loader": "^9.0.0",
    "cross-env": "^7.0.3",
    {{#lint}}
    "eslint-plugin-vue": "^9.18.0",
    {{/lint}}
    "express": "^4.18.0",
    "hygen": "^6.2.0",
    "imagemin-lint-staged": "^0.5.1",
    {{#lint}}
    "lint-staged": "^15.0.0",
    "markdownlint-cli": "^0.37.0",
    {{/lint}}
    "sass": "^1.69.0",
    "number-precision": "^1.6.0",
    "qs": "^6.11.0",
    "sass-loader": "^13.3.0",
    {{#lint}}
    "stylelint": "^15.11.0",
    "stylelint-config-css-modules": "^4.3.0",
    "stylelint-config-prettier": "^9.0.0",
    "stylelint-config-recess-order": "^4.3.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-scss": "^5.3.0",
    {{/lint}}
    {{#typescript}}
    "typescript": "^5.2.0",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/eslint-config-typescript": "^12.0.0",
    {{/typescript}}
    {{#if_and typescript unit}}
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@types/lodash-es": "^4.17.0",
    {{/if_and}}
    "@vitejs/plugin-vue": "^4.5.0",
    "vite": "^4.5.0",
    "vuepress": "^2.0.0-beta.67",
    "webpack-manifest-plugin": "^5.0.0"
  }
}
